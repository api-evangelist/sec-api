{
  "info": {
    "name": "SEC API (sec-api.io) REST API",
    "description": "REST endpoints for SEC API (sec-api.io) - Filing Query, Full-Text Search, XBRL-to-JSON, Extractor, Insider Trading (Form 3/4/5), and Form 13F institutional holdings. The real-time Filing Stream API is a WebSocket (wss://stream.sec-api.io) and is not represented here. Authenticate with your API token via the Authorization header or the token query parameter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.sec-api.io", "type": "string" },
    { "key": "apiKey", "value": "YOUR_API_KEY", "type": "string" }
  ],
  "item": [
    {
      "name": "Filing Query",
      "item": [
        {
          "name": "Search EDGAR filings by metadata",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}", "host": [ "{{baseUrl}}" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"formType:\\\"10-Q\\\"\",\n  \"from\": \"0\",\n  \"size\": \"50\",\n  \"sort\": [{ \"filedAt\": { \"order\": \"desc\" } }]\n}"
            },
            "description": "Search 18M+ EDGAR filings (1993-present) across 400+ form types using Lucene syntax over filing metadata."
          }
        }
      ]
    },
    {
      "name": "Full-Text Search",
      "item": [
        {
          "name": "Full-text search across filings and exhibits",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/full-text-search", "host": [ "{{baseUrl}}" ], "path": [ "full-text-search" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"\\\"climate change\\\"\",\n  \"formTypes\": [\"8-K\", \"10-K\"],\n  \"startDate\": \"2024-01-01\",\n  \"endDate\": \"2024-12-31\",\n  \"page\": \"1\"\n}"
            },
            "description": "Keyword and phrase search across the full text of all EDGAR filings and exhibits published since 2001."
          }
        }
      ]
    },
    {
      "name": "XBRL-to-JSON",
      "item": [
        {
          "name": "Convert filing XBRL to JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/xbrl-to-json?accession-no=0001564590-21-004599",
              "host": [ "{{baseUrl}}" ],
              "path": [ "xbrl-to-json" ],
              "query": [ { "key": "accession-no", "value": "0001564590-21-004599" } ]
            },
            "description": "Convert the XBRL financial data in a filing into standardized JSON financial statements. Alternatively use htm-url or xbrl-url."
          }
        }
      ]
    },
    {
      "name": "Extractor",
      "item": [
        {
          "name": "Extract a section (item) from a filing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/extractor?url=FILING_URL&item=1A&type=text",
              "host": [ "{{baseUrl}}" ],
              "path": [ "extractor" ],
              "query": [
                { "key": "url", "value": "FILING_URL" },
                { "key": "item", "value": "1A" },
                { "key": "type", "value": "text" }
              ]
            },
            "description": "Extract a single textual section from a 10-K, 10-Q, or 8-K filing, e.g. 10-K Item 1A (Risk Factors)."
          }
        }
      ]
    },
    {
      "name": "Insider Trading",
      "item": [
        {
          "name": "Query insider transactions (Form 3/4/5)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/insider-trading", "host": [ "{{baseUrl}}" ], "path": [ "insider-trading" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"issuer.tradingSymbol:TSLA\",\n  \"from\": \"0\",\n  \"size\": \"50\",\n  \"sort\": [{ \"filedAt\": { \"order\": \"desc\" } }]\n}"
            },
            "description": "Search structured insider transaction data parsed from SEC Form 3, 4, and 5 filings."
          }
        }
      ]
    },
    {
      "name": "Form 13F",
      "item": [
        {
          "name": "Query Form 13F holdings",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/form-13f/holdings", "host": [ "{{baseUrl}}" ], "path": [ "form-13f", "holdings" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"accessionNo:\\\"0001067983-23-000012\\\"\",\n  \"from\": \"0\",\n  \"size\": \"50\"\n}"
            },
            "description": "Search quarterly institutional portfolio holdings from Form 13F filings (CUSIP, ticker, shares, value)."
          }
        },
        {
          "name": "Query Form 13F cover pages",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/form-13f/cover-pages", "host": [ "{{baseUrl}}" ], "path": [ "form-13f", "cover-pages" ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"filedAt:[2024-01-01 TO 2024-03-31]\",\n  \"from\": \"0\",\n  \"size\": \"50\"\n}"
            },
            "description": "Search Form 13F cover-page metadata (manager, report period, filing details)."
          }
        }
      ]
    }
  ]
}
